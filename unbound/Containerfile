FROM docker.io/alpine:latest

# Build-time arguments
ARG REPO_URL REVISION

# Metadata according to OCI standards
LABEL org.opencontainers.image.title="Unbound DNS" \
      org.opencontainers.image.description="Lightweight Unbound DNS image" \
      org.opencontainers.image.authors="Giuseppe Rocco" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="${REPO_URL}" \
      org.opencontainers.image.revision="${REVISION}"

# Update and install just unbound and wget
RUN apk update && \
    apk add --no-cache --update unbound

WORKDIR /etc/unbound

# Exposing tcp/udp by default
EXPOSE 53/tcp 53/udp

# Finally set the entrypoint
ENTRYPOINT ["/usr/sbin/unbound", "-dpc", "/etc/unbound/unbound.conf"]