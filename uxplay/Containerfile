ARG ALPINE_VERSION=3.23
FROM docker.io/library/alpine:${ALPINE_VERSION} AS builder

ARG UXPLAY_VERSION=v1.73.4

WORKDIR /src

RUN apk add --no-cache \
    build-base \
    git \
    cmake \
    pkgconf \
    libx11-dev \
    openssl-dev \
    libplist-dev \
    avahi-dev \
    gstreamer-dev \
    gst-plugins-base-dev
    
RUN git clone --depth 1 --branch "${UXPLAY_VERSION}" https://github.com/FDH2/UxPlay.git && \
    cmake -S UxPlay -B build -DCMAKE_BUILD_TYPE=Release -DNO_MARCH_NATIVE=ON && \
    cmake --build build --parallel && strip build/uxplay

FROM docker.io/library/alpine:${ALPINE_VERSION}
ARG REPO_URL REVISION UXPLAY_VERSION=v1.73.4

LABEL org.opencontainers.image.title="UxPlay (rootless)" \
      org.opencontainers.image.version="${UXPLAY_VERSION}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.authors="Giuseppe Rocco" \
      org.opencontainers.image.description="AirPlay receiver for a Linux desktop session" \
      org.opencontainers.image.source="${REPO_URL}" \
      org.opencontainers.image.revision="${REVISION}"
      
RUN apk add --no-cache \
    libgcc \
    libstdc++ \
    libx11 \
    libcrypto3 \
    libssl3 \
    libplist \
    avahi-compat-libdns_sd \
    gstreamer \
    gst-plugins-base \
    gst-plugins-good \
    gst-plugins-bad \
    gst-libav \
    gst-plugin-pipewire && \
    addgroup -g 1000 uxplay && \
    adduser -D -u 1000 -G uxplay uxplay && \
    install -o uxplay -g uxplay -m 0700 -d /run/user/1000
    
COPY --from=builder /src/build/uxplay /usr/local/bin/uxplay

ENV HOME=/home/uxplay \
    XDG_RUNTIME_DIR=/run/user/1000 \
    XDG_CACHE_HOME=/tmp/.cache \
    GST_REGISTRY=/tmp/gstreamer-registry.bin

WORKDIR /home/uxplay
USER 1000:1000

ENTRYPOINT ["/usr/local/bin/uxplay"]